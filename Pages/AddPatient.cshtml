@page
@model AddPatientModel
<h2>Add Patient</h2>

<div class="container">
    <form method="post">
        <label>Name:</label>
        <input type="text" asp-for="PatientName" required />

        <label>Age:</label>
        <input type="number" asp-for="PatientAge" required />

        <button type="submit">Add Patient</button>
    </form>

    @if (Model.Message != null)
    {
        <div class="success">@Model.Message</div>
    }

    <h3>Existing Patients</h3>
    @foreach(var p in Model.Patients)
    {
        <div class="card">
            <strong>Name:</strong> @p.Name <br/>
            <strong>Age:</strong> @p.Age
        </div>
    }
</div>
